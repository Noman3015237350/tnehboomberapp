function dedupe(list) {
  const seen = new Set();
  const out = [];
  let id = 5000;
  for (const a of list) {
    const key = `${a.method}::${a.url}`;
    if (seen.has(key)) continue;
    seen.add(key);
    out.push({
      id: id++,
      name: a.name,
      method: a.method,
      url: a.url,
      body: a.body || null
    });
  }
  return out;
}

